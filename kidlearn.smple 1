/* =====================================================
   TEACHER VOICE
===================================================== */

function speak(text) {

    if (!("speechSynthesis" in window)) {

        return;
    }

    speechSynthesis.cancel();

    const voices =
        speechSynthesis.getVoices();

    let voice =
        voices.find(function(v) {

            return v.lang &&
                v.lang
                .toLowerCase()
                .startsWith("en-in");

        });


    if (!voice) {

        voice =
            voices.find(function(v) {

                return v.lang &&
                    v.lang
                    .toLowerCase()
                    .startsWith("en");

            });

    }


    const speech =
        new SpeechSynthesisUtterance(text);

    if (voice) {

        speech.voice = voice;

    }


    speech.rate = 0.68;

    speech.pitch = 1.05;

    speech.volume = 1;


    speechSynthesis.speak(
        speech
    );
}


/* =====================================================
