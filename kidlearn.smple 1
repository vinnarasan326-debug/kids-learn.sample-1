<style>

/* =====================================================
   BASIC
===================================================== */

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {

    margin: 0;

    font-family:
        "Comic Sans MS",
        "Trebuchet MS",
        Arial,
        sans-serif;

    background:
        linear-gradient(
            135deg,
            #fff1f8,
            #e9f8ff,
            #fff9d6
        );

    color: #333;
}


/* =====================================================
   HEADER
===================================================== */

header {

    text-align: center;

    padding: 25px 15px;

    background:
        linear-gradient(
            135deg,
            #ff8fab,
            #ffb3c6,
            #8ed8f8
        );

    color: white;

    box-shadow:
        0 5px 15px #bbb;
}

header h1 {

    margin: 0;

    font-size: 42px;
}

header p {

    font-size: 19px;

    margin-bottom: 0;
}


/* =====================================================
   NAVIGATION
===================================================== */

nav {

    position: sticky;

    top: 0;

    z-index: 1000;

    background: white;

    padding: 10px;

    text-align: center;

    box-shadow:
        0 4px 12px #ccc;
}

nav button {

    border: none;

    margin: 4px;

    padding: 10px 16px;

    border-radius: 25px;

    background: #ffd166;

    font-size: 15px;

    font-weight: bold;

    cursor: pointer;

    transition:
        transform .2s ease,
        background .2s ease;

    touch-action: manipulation;
}

nav button:hover {

    background: #ffb703;

    transform: scale(1.07);
}

nav button:active {

    transform: scale(.92);
}


/* =====================================================
   HOME
===================================================== */

.hero {

    text-align: center;

    padding: 45px 15px;
}

.baby {

    display: inline-block;

    font-size: 120px;

    animation:
        babyIdle 2.5s
        ease-in-out
        infinite;
}

@keyframes babyIdle {

    0%, 100% {

        transform:
            translateY(0);
    }

    50% {

        transform:
            translateY(-8px);
    }
}

.baby-happy {

    animation:
        babyHappy 1s ease;
}

@keyframes babyHappy {

    0% {

        transform:
            scale(1)
            translateY(0);
    }

    30% {

        transform:
            scale(1.12)
            translateY(-15px);
    }

    55% {

        transform:
            scale(1.05)
            translateY(0);
    }

    75% {

        transform:
            scale(1.1)
            translateY(-8px);
    }

    100% {

        transform:
            scale(1)
            translateY(0);
    }
}

.hero h2 {

    color: #ff4f81;

    font-size: 35px;
}

.hero p {

    font-size: 20px;
}

.speech {

    display: inline-block;

    max-width: 90%;

    padding: 18px 28px;

    background: white;

    border-radius: 30px;

    color: #ff4f81;

    font-size: 20px;

    font-weight: bold;

    box-shadow:
        0 5px 15px #bbb;

    transition: .3s ease;
}


/* =====================================================
   START BUTTON
===================================================== */

.start-button {

    border: none;

    margin: 25px;

    padding: 16px 35px;

    border-radius: 30px;

    background:
        linear-gradient(
            90deg,
            #ff8fab,
            #ff4f81
        );

    color: white;

    font-size: 21px;

    font-weight: bold;

    cursor: pointer;

    box-shadow:
        0 5px 15px #bbb;

    transition:
        transform .25s ease;

    touch-action: manipulation;
}

.start-button:hover {

    transform:
        scale(1.06);
}

.start-button:active {

    transform:
        scale(.94);
}


/* =====================================================
   GRID
===================================================== */

.grid {

    max-width: 1100px;

    margin: auto;

    display: grid;

    grid-template-columns:
        repeat(
            auto-fit,
            minmax(150px, 1fr)
        );

    gap: 20px;
}


/* =====================================================
   CARDS
===================================================== */

.card {

    position: relative;

    min-height: 175px;

    padding: 20px;

    background: white;

    border-radius: 25px;

    box-shadow:
        0 7px 18px #ccc;

    cursor: pointer;

    -webkit-tap-highlight-color:
        transparent;

    touch-action: manipulation;

    transition:
        transform .25s ease,
        box-shadow .25s ease;
}

.card:hover {

    transform:
        translateY(-6px)
        scale(1.02);

    box-shadow:
        0 12px 25px #bbb;
}

.card:active {

    transform:
        scale(.94);
}

.card.touching {

    transform:
        scale(1.05);

    box-shadow:
        0 12px 30px
        rgba(255,143,171,.45);
}


/* =====================================================
   HOME CARDS
===================================================== */

.home-card {

    min-height: 190px;

    display: flex;

    flex-direction: column;

    justify-content: center;

    align-items: center;
}

.home-icon {

    font-size: 65px;

    animation:
        iconIdle 2s
        ease-in-out
        infinite;
}

@keyframes iconIdle {

    0%, 100% {

        transform:
            translateY(0);
    }

    50% {

        transform:
            translateY(-7px);
    }
}

.home-card h3 {

    margin: 8px 0;

    font-size: 24px;

    color: #ff4f81;
}


/* =====================================================
   SECTIONS
===================================================== */

section {

    padding: 55px 15px;

    text-align: center;
}

section h2 {

    color: #ff4f81;

    font-size: 32px;
}

.section-text {

    font-size: 18px;
}


/* =====================================================
   ABC
===================================================== */

.letter {

    font-size: 70px;

    color: #ff4f81;

    font-weight: bold;
}

.letter-touch {

    animation:
        letterBounce .65s ease;
}

@keyframes letterBounce {

    0% {

        transform:
            scale(1);
    }

    40% {

        transform:
            scale(1.3);
    }

    70% {

        transform:
            scale(1.08);
    }

    100% {

        transform:
            scale(1);
    }
}

.word {

    font-size: 20px;

    font-weight: bold;
}


/* =====================================================
   NUMBERS
===================================================== */

.number {

    font-size: 70px;

    color: #ff8a00;

    font-weight: bold;
}

.number-touch {

    animation:
        numberPop .6s ease;
}

@keyframes numberPop {

    0% {

        transform:
            scale(1);
    }

    50% {

        transform:
            scale(1.3)
            rotate(4deg);
    }

    100% {

        transform:
            scale(1);
    }
}

.count {

    font-size: 23px;
}


/* =====================================================
   COLOURS
===================================================== */

.color-circle {

    width: 105px;

    height: 105px;

    margin: auto;

    border-radius: 50%;

    transition:
        transform .3s ease;
}

.card.touching
.color-circle {

    transform:
        scale(1.12);
}

.red {
    background: #ff4d6d;
}

.blue {
    background: #4dabf7;
}

.green {
    background: #69db7c;
}

.yellow {
    background: #ffd43b;
}

.purple {
    background: #b197fc;
}

.orange {
    background: #ff922b;
}

.pink {
    background: #f783ac;
}

.sky {
    background: #74c0fc;
}


/* =====================================================
   SHAPES
===================================================== */

.shape {

    width: 100px;

    height: 100px;

    margin: auto;

    transition:
        transform .3s ease;
}

.card.touching
.shape {

    transform:
        scale(1.12)
        rotate(5deg);
}

.circle {

    background: #ff6b81;

    border-radius: 50%;
}

.square {

    background: #4dabf7;
}

.triangle {

    width: 0;

    height: 0;

    border-left:
        55px solid transparent;

    border-right:
        55px solid transparent;

    border-bottom:
        100px solid #69db7c;
}

.star {

    font-size: 85px;
}


/* =====================================================
   ANIMALS
===================================================== */

.animal {

    display: inline-block;

    font-size: 80px;
}

.animal-touch {

    animation:
        smoothAnimal .8s
        ease-in-out;
}

@keyframes smoothAnimal {

    0% {

        transform:
            scale(1)
            translateY(0)
            rotate(0);
    }

    20% {

        transform:
            scale(1.08)
            translateY(-8px)
            rotate(-3deg);
    }

    45% {

        transform:
            scale(1.15)
            translateY(-22px)
            rotate(4deg);
    }

    65% {

        transform:
            scale(1.10)
            translateY(-10px)
            rotate(-3deg);
    }

    100% {

        transform:
            scale(1)
            translateY(0)
            rotate(0);
    }
}


/* =====================================================
   SOUND BUBBLE
===================================================== */

.sound-bubble {

    position: absolute;

    left: 50%;

    top: 25%;

    background: white;

    padding: 8px 14px;

    border-radius: 20px;

    color: #ff4f81;

    font-weight: bold;

    pointer-events: none;

    animation:
        bubbleUp 1.3s
        ease forwards;
}

@keyframes bubbleUp {

    0% {

        opacity: 0;

        transform:
            translate(-50%,10px)
            scale(.7);
    }

    20% {

        opacity: 1;

        transform:
            translate(-50%,0)
            scale(1);
    }

    100% {

        opacity: 0;

        transform:
            translate(-50%,-75px)
            scale(1.05);
    }
}


/* =====================================================
   SPARKLES
===================================================== */

.touch-sparkle {

    position: fixed;

    pointer-events: none;

    z-index: 9999;

    font-size: 22px;

    animation:
        sparkleMove .9s
        ease-out forwards;
}

@keyframes sparkleMove {

    0% {

        opacity: 1;

        transform:
            translate(0,0)
            scale(.5);
    }

    50% {

        opacity: 1;

        transform:
            translate(var(--x),-30px)
            scale(1);
    }

    100% {

        opacity: 0;

        transform:
            translate(
                calc(var(--x) * 1.5),
                -90px
            )
            scale(.7);
    }
}


/* =====================================================
   QUIZ
===================================================== */

.quiz-box {

    max-width: 650px;

    margin: auto;

    padding: 30px;

    background: white;

    border-radius: 30px;

    box-shadow:
        0 8px 20px #ccc;
}

.quiz-box h3 {

    color: #ff8a00;

    font-size: 23px;
}

#quizProgress {

    color: #777;

    margin-bottom: 15px;

    font-weight: bold;
}

.quiz-question {

    font-size: 25px;

    font-weight: bold;

    color: #ff4f81;

    margin-bottom: 25px;
}

.quiz-button {

    display: block;

    width: 85%;

    margin: 12px auto;

    padding: 15px;

    border: none;

    border-radius: 20px;

    background: #6ecbff;

    color: white;

    font-size: 18px;

    font-weight: bold;

    cursor: pointer;

    touch-action: manipulation;

    transition:
        transform .2s ease,
        background .2s ease;
}

.quiz-button:hover {

    transform:
        scale(1.03);
}

.quiz-button:active {

    transform:
        scale(.94);
}

.quiz-button:disabled {

    cursor: default;
}

#quizResult {

    font-size: 21px;

    font-weight: bold;

    min-height: 35px;

    margin-top: 15px;
}

#quizScore {

    margin-top: 20px;

    color: #ff4f81;

    font-size: 20px;

    font-weight: bold;
}


/* =====================================================
   FOOTER
===================================================== */

footer {

    background: #ff8fab;

    color: white;

    text-align: center;

    padding: 25px;

    font-size: 18px;
}


/* =====================================================
   MOBILE
===================================================== */

@media(max-width:600px) {

    header h1 {

        font-size: 30px;
    }

    .baby {

        font-size: 85px;
    }

    .hero h2 {

        font-size: 27px;
    }

    section h2 {

        font-size: 27px;
    }

    .grid {

        grid-template-columns:
            repeat(2,1fr);

        gap: 12px;
    }

    .card {

        padding: 14px;

        min-height: 155px;
    }

    nav button {

        font-size: 13px;

        padding: 8px 11px;
    }

    .animal {

        font-size: 65px;
    }

    .letter,
    .number {

        font-size: 55px;
    }

    .quiz-box {

        padding: 20px 12px;
    }

    .quiz-question {

        font-size: 21px;
    }

}


/* =====================================================
   REDUCED MOTION
===================================================== */

@media(prefers-reduced-motion: reduce) {

    *,
    *::before,
    *::after {

        animation-duration:
            .01ms !important;

        animation-iteration-count:
            1 !important;

        scroll-behavior:
            auto !important;
    }

}

</style>

