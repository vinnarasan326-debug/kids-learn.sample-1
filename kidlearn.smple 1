/* =====================================================
   QUIZ VARIABLES
===================================================== */

let todayQuiz = [];

let currentQuestion = 0;

let quizScore = 0;


/* =====================================================
   GET TODAY'S QUIZ
===================================================== */

function getTodayQuiz() {

    const today =
        new Date();


    const start =
        new Date(
            today.getFullYear(),
            0,
            0
        );


    const difference =
        today - start;


    const oneDay =
        1000 *
        60 *
        60 *
        24;


    const dayOfYear =
        Math.floor(
            difference /
            oneDay
        );


    /*
       7 sample quiz sets.

       Each new day gets
       the next set.

       You can add 30 sets
       for 30 different days.
    */

    const quizNumber =
        dayOfYear %
        dailyQuestions.length;


    return dailyQuestions[
        quizNumber
    ];
}


/* =====================================================
   LOAD QUIZ
===================================================== */

function loadDailyQuiz() {

    todayQuiz =
        getTodayQuiz();


    currentQuestion = 0;

    quizScore = 0;


    document.getElementById(
        "quizScore"
    ).innerHTML = "";


    document.getElementById(
        "dayTitle"
    ).innerHTML =
        "📅 Today's Fun Quiz! 🌈";


    showQuizQuestion();
}


/* =====================================================
   SHOW QUESTION
===================================================== */

function showQuizQuestion() {

    const question =
        todayQuiz[
            currentQuestion
        ];


    document.getElementById(
        "quizProgress"
    ).innerHTML =
        "Question " +
        (currentQuestion + 1) +
        " of 3";


    document.getElementById(
        "quizQuestion"
    ).innerHTML =
        question.question;


    document.getElementById(
        "quizResult"
    ).innerHTML =
        "";


    document.getElementById(
        "nextQuestion"
    ).style.display =
        "none";


    const options =
        document.getElementById(
            "quizOptions"
        );


    options.innerHTML = "";


    question.options.forEach(
        function(
            option,
            index
        ) {

            const button =
                document.createElement(
                    "button"
                );


            button.className =
                "quiz-button";


            button.innerHTML =
                option;


            button.onclick =
                function() {

                    checkDailyAnswer(
                        index,
                        button
                    );

                };


            options.appendChild(
                button
            );

        }
    );
}


/* =====================================================
   CHECK QUIZ ANSWER
===================================================== */

function checkDailyAnswer(
    selected,
    button
) {

    const question =
        todayQuiz[
            currentQuestion
        ];


    const allButtons =
        document.querySelectorAll(
            "#quizOptions .quiz-button"
        );


    allButtons.forEach(
        function(btn) {

            btn.disabled = true;

        }
    );


    if (
        selected ===
        question.answer
    ) {

        quizScore++;


        button.style.background =
            "#69db7c";


        document.getElementById(
            "quizResult"
        ).innerHTML =
            "🎉 Correct! Very Good! ⭐";


        speak(
            "Very good! That is correct!"
        );


        createTouchSparkles(
            button
        );

    }

    else {

        button.style.background =
            "#ff8787";


        document.getElementById(
            "quizResult"
        ).innerHTML =
            "😊 Nice try! Try again tomorrow!";


        speak(
            "Nice try! Keep learning!"
        );

    }


    document.getElementById(
        "nextQuestion"
    ).style.display =
        "inline-block";
}


/* =====================================================
   NEXT QUESTION
===================================================== */

function nextQuizQuestion() {

    currentQuestion++;


    if (
        currentQuestion >=
        todayQuiz.length
    ) {

        finishDailyQuiz();

        return;
    }


    showQuizQuestion();
}


