===================================================== */

function babyHappy() {

    const baby =
        document.getElementById(
            "baby"
        );

    baby.classList.remove(
        "baby-happy"
    );

    void baby.offsetWidth;

    baby.classList.add(
        "baby-happy"
    );


    setTimeout(function() {

        baby.classList.remove(
            "baby-happy"
        );

    }, 1000);
}


/* =====================================================
   TOUCH ANIMATION
===================================================== */

function smoothTouch(
    element,
    type
) {

    element.classList.remove(
        "touching",
        "animal-touch",
        "letter-touch",
        "number-touch"
    );

    void element.offsetWidth;

    element.classList.add(
        "touching"
    );


    if (type === "animal") {

        element.classList.add(
            "animal-touch"
        );

    }


    if (type === "letter") {

        element.classList.add(
            "letter-touch"
        );

    }


    if (type === "number") {

        element.classList.add(
            "number-touch"
        );

    }


    createTouchSparkles(
        element
    );

    babyHappy();


    setTimeout(function() {

        element.classList.remove(
            "touching",
            "animal-touch",
            "letter-touch",
            "number-touch"
        );

    }, 900);
}


/* =====================================================
   SPARKLES
===================================================== */

function createTouchSparkles(
    element
) {

    const rect =
        element.getBoundingClientRect();


    const icons = [
        "✨",
        "⭐",
        "🌟",
        "💖"
    ];


    for (
        let i = 0;
        i < 7;
        i++
    ) {

        const sparkle =
            document.createElement(
                "div"
            );


        sparkle.className =
            "touch-sparkle";


        sparkle.innerHTML =
            icons[
                Math.floor(
                    Math.random()
                    * icons.length
                )
            ];


        sparkle.style.left =
            (
                rect.left +
                rect.width / 2
            ) + "px";


        sparkle.style.top =
            (
                rect.top +
                rect.height / 2
            ) + "px";


        sparkle.style.setProperty(
            "--x",
            (
                (Math.random() - .5)
                * 100
            ) + "px"
        );


        document.body.appendChild(
            sparkle
        );


        setTimeout(function() {

            sparkle.remove();

        }, 900);
    }
}


